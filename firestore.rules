rules_version = '2';

// Allow read/write if the user is authenticated
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /classes/{classId} {
      allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classes;
    }

    match /students/{studentId} {
      allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classes;
    }

    match /attendance/{attendanceId} {
      allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classes;
      allow write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classes;
    }
  }
}